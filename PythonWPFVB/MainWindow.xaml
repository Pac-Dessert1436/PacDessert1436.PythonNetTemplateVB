<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PythonWPFVB"
        mc:Ignorable="d"
        Title="PythonWPFVB: Python Interop Demo" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="5">
            <Button x:Name="btnExecutePython" Content="Execute Python Code" Margin="10" Padding="10,5"/>
            <Button x:Name="btnMathDemo" Content="Run Math Demo" Margin="10" Padding="10,5"/>
            <Button x:Name="btnRandomDemo" Content="Generate Random Numbers" Margin="10" Padding="10,5"/>
            <Button x:Name="btnClear" Content="Clear Output" Margin="10" Padding="10,5"/>
        </StackPanel>
        
        <StackPanel DockPanel.Dock="Top" Margin="5">
            <Label Content="Python Code:" Margin="0,0,0,5"/>
            <TextBox x:Name="txtPythonCode" AcceptsReturn="True" AcceptsTab="True" 
                     Height="150" VerticalScrollBarVisibility="Auto" 
                     Text="print('Hello from Python in WPF!')"/>
        </StackPanel>
        
        <StackPanel Margin="5">
            <Label Content="Output:" Margin="0,0,0,5"/>
            <TextBox x:Name="txtOutput" IsReadOnly="True" Height="260" 
                     VerticalScrollBarVisibility="Auto" Foreground="DarkGreen"/>
        </StackPanel>
    </DockPanel>
</Window>